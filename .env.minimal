# Minimal configuration for FID-filtered cast streaming

# Snapchain connection
WAYPOINT_HUB__URL=your_snapchain_endpoint

# FID Filter - Configure your allowed FIDs here (comma-separated)
# Example: WAYPOINT_FID_FILTER__ALLOWED_FIDS=1,2,3,4,5
WAYPOINT_FID_FILTER__ENABLED=true
WAYPOINT_FID_FILTER__ALLOWED_FIDS=977233,129,3,557

# Redis configuration (using host machine's Redis)
WAYPOINT_REDIS__URL=redis://localhost:6379

# Disable database storage (Redis only)
WAYPOINT_DATABASE__STORE_MESSAGES=false
WAYPOINT_DATABASE__URL=postgresql://postgres:postgres@localhost:5432/waypoint

# Logging
RUST_LOG=info
LOG_LEVEL=INFO

# Performance tuning for minimal RAM
WAYPOINT_REDIS__POOL_SIZE=20
WAYPOINT_REDIS__BATCH_SIZE=50

# Disable unnecessary features
WAYPOINT_MCP__ENABLED=false
WAYPOINT_STATSD__ENABLED=false
